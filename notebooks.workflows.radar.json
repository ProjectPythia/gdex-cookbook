earth * np.sin(e)) - r_earth) / 1000.0\n\n\nds_rhi[\"rhi_alt\"] = rhi_altitude(ds_rhi[\"range\"], ds_rhi[\"elevation\"]).compute()\nds_rhi = ds_rhi.set_coords(\"rhi_alt\")\nds_rhi[\"range\"] = ds_rhi[\"range\"] / 1000.0\nds_rhi[\"rhi_alt\"].attrs = {\"long_name\": \"RHI altitude\", \"units\": \"km\"}\nds_rhi[\"range\"].attrs[\"units\"] = \"km\"","key":"unqfmkmkTQ"},{"type":"outputs","id":"-tnkRilkpgTLefbWQctLn","children":[],"key":"lFh0cZBRtC"}],"key":"X4s9wIlfEk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(16, 4))\nds_rhi[\"DBZ\"].plot.pcolormesh(\n    x=\"range\",\n    y=\"rhi_alt\",\n    cmap=\"ChaseSpectral\",\n    levels=np.arange(-10, 55, 1),\n    ax=ax,\n    cbar_kwargs={\"label\": \"Reflectivity (dBZ)\"},\n)\nax.set_xlabel(\"Range (km)\")\nax.set_ylabel(\"Altitude (km)\")\nax.set_xlim(0, 150)\nax.set_ylim(0, 15)\nax.set_title(\n    f\"S-Pol RHI reflectivity — 2022-05-25 \"\n    f\"(lon {ds_rhi.longitude.values:.2f}, lat {ds_rhi.latitude.values:.2f})\"\n)\nplt.show()","key":"IEYhxAyEEc"},{"type":"outputs","id":"MtsnGcxpbgjDpT4TvBEvM","children":[],"key":"JAbUaXe9aj"}],"key":"PYvRFuZzNY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing the PPI (horizontal) scan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NnA8QJEakU"}],"identifier":"visualizing-the-ppi-horizontal-scan","label":"Visualizing the PPI (horizontal) scan","html_id":"visualizing-the-ppi-horizontal-scan","implicit":true,"key":"dgvmPgOzQu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For the surveillance scan we use ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WYyr23BUWY"},{"type":"inlineCode","value":"xradar","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ntST7qf4GQ"},{"type":"text","value":" to georeference the polar coordinates into\nCartesian ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hDceErqG9a"},{"type":"inlineCode","value":"x","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jvQ6fooeXe"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R4MYaQxjHH"},{"type":"inlineCode","value":"y","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kNArVWCRnS"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"M7yy2KCdE9"},{"type":"inlineCode","value":"z","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VnFXKENmrS"},{"type":"text","value":", then map reflectivity onto a Cartopy projection for\ngeographic context.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"J1w8WRZBll"}],"key":"WfPksMNXem"}],"key":"S2S9XM2Min"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dt_ppi = dt_ppi.xradar.georeference()\ndt_ppi = xd.georeference.get_x_y_z_tree(dt_ppi)\nds_ppi = dt_ppi[\"sweep_0\"].to_dataset()\nda_dbz = ds_ppi[\"DBZ\"]","key":"no9zJYIDKx"},{"type":"outputs","id":"QbtygmX-vVItSsN3XJXq8","children":[],"key":"yoxpNNUiOU"}],"key":"gprmUtMARF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"radar_crs = ccrs.Projection(xd.georeference.get_crs(ds_ppi))\n\nfig = plt.figure(figsize=(10, 10))\nax = fig.add_subplot(111, projection=ccrs.PlateCarree())\nda_dbz.plot(\n    x=\"x\",\n    y=\"y\",\n    transform=radar_crs,\n    cmap=\"ChaseSpectral\",\n    levels=np.arange(-10, 55, 1),\n    cbar_kwargs={\"label\": \"Reflectivity (dBZ)\", \"shrink\": 0.75, \"pad\": 0.075},\n)\nax.coastlines(