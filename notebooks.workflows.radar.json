 (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CorHFPl2kM"},{"type":"inlineCode","value":"sweep_0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"u5158BEpcS"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sRogR8cEZ3"},{"type":"inlineCode","value":"sweep_1","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"L2njmT5WJB"},{"type":"text","value":", …) is a node in the tree.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DkLKHHbYMg"}],"key":"xHnatgOwvd"}],"identifier":"796a79df-6f4f-4653-81e8-71a7e55708b5","html_id":"796a79df-6f4f-4653-81e8-71a7e55708b5","key":"O9GZRmQWWq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dt_rhi = xr.open_datatree(rhi_url, engine=\"zarr\", decode_timedelta=False)\ndt_ppi = xr.open_datatree(ppi_url, engine=\"zarr\", decode_timedelta=False)\ndt_rhi","key":"rcpnVPhAma"},{"type":"outputs","id":"T-Dyu9M-FWm467xZOx9us","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"error","traceback":"\u001b[31m--------------------------------------------------------...","ename":"ClientPayloadError","evalue":"Response payload is not completed: <ContentLengthError: 400, message='Not enough data to satisfy content length header (received 0 of 172 bytes).'>","hash":"f53b5f6a60bd76e761d31101d4db8010","path":"/gdex-cookbook/build/f53b5f6a60bd76e761d31101d4db8010.txt"},"key":"Jpaegy0fH8"}],"key":"Q6m2Q3cXPM"}],"identifier":"c9a620b3-a547-40bf-940b-c9d45e335a39","html_id":"c9a620b3-a547-40bf-940b-c9d45e335a39","key":"Z14ZdwYkHo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing the RHI (vertical) scan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bXdig4mCHK"}],"identifier":"visualizing-the-rhi-vertical-scan","label":"Visualizing the RHI (vertical) scan","html_id":"visualizing-the-rhi-vertical-scan","implicit":true,"key":"PMJBUBpiFu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We extract the first sweep, compute each gate’s altitude from its range and\nelevation angle (accounting for Earth’s curvature), and plot reflectivity as a\nrange–altitude cross-section.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vzwxJpao8a"}],"key":"VnjRo0vblE"}],"identifier":"52d5b0d8-c713-4f5e-a276-212dc82ff308","html_id":"52d5b0d8-c713-4f5e-a276-212dc82ff308","key":"f7FkIQAQ1r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_rhi = dt_rhi[\"sweep_0\"].to_dataset()\n\n\ndef rhi_altitude(r, elevation_deg):\n    \"\"\"Beam altitude (km) from range (m) and elevation angle (deg), with Earth curvature.\"\"\"\n    r_earth = 6_371_000.0\n    e = np.deg2rad(elevation_deg)\n    return (np.sqrt(r**2 + r_earth**2 + 2 * r * r_earth * np.sin(e)) - r_earth) / 1000.0\n\n\nds_rhi[\"rhi_alt\"] = rhi_altitude(ds_rhi[\"range\"], ds_rhi[\"elevation\"]).compute()\nds_rhi = ds_rhi.set_coords(\"rhi_alt\")\nds_rhi[\"range\"] = ds_rhi[\"range\"] / 1000.0\nds_rhi[\"rhi_alt\"].attrs = {\"long_name\": \"RHI altitude\", \"units\": \"km\"}\nds_rhi[\"range\"].attrs[\"units\"] = \"km\"","key":"h8hF9XTuqJ"},{"type":"outputs","id":"evigPP24nKJjDOYeOoFie","children":[],"key":"Qo6vmdijxG"}],"identifier":"e5821db7-bf9c-47ed-a72d-7a168a8bd98d","html_id":"e5821db7-bf9c-47ed-a72d-7a168a8bd98d","key":"Jrn1hVB9I9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(16, 4))\nds_rhi[\"DBZ\"].plot.pcolormesh(\n    x=\"range\",\n    y=\"rhi_alt\",\n    cmap=\"ChaseSpectral\",\n    levels=np.arange(-10, 55, 1),\n    ax=ax,\n    cbar_kwargs={\"label\": \"Reflectivity (dBZ)\"},\n)\nax.set_xlabel(\"Range (km)\")\nax.set_ylabel(\"Altitude (km)\")\nax.set_xlim(0, 150)\nax.set_ylim(0, 15)\nax.set_title(\n    f\"S-Pol RHI reflectivity — 2022-05-25 \"\n    f\"(lon {ds_rhi.longitude.values:.2f}, lat {ds_rhi.latitude.values:.2f})\"\n)\nplt.show()","key":"kLmjQlGb0W"},{"type":"outputs","id":"SN90NZ08Vz__QEyxuo54_","children":[],"key":"DbSCRg90Tv"}],"identifier":"f4c8965f-e4b9-42b5-9930-f5b631a101ea","html_id":"f4c8965f-e4b9-42b5-9930-f5b631a101ea","key":"LpErqwln5A"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing the PPI (horizontal) scan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nVdp1fDjnA"}],"identifier":"visualizing-the-ppi-horizontal-scan","label":"Visualizing the PPI (horizontal) scan","html_id":"visualizing-the-ppi-horizontal-scan","implicit":true,"key":"G0nVCZLzmP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For the surveillance scan we use ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HjQTrpPqk0"},{"type":"inlineCode","value":"xradar","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TPKgcQx5jO"},{"type":"text","value":" to georeference the polar coordinates into\nCartesian ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NIk0ortApk"},{"type":"inlineCode","value":"x","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MaDc2uRhY1"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"n1xfRfxCJ7"},{"type":"inlineCode","value":"y","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R7gZgGZNgz"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DEaPeKDdl0"},{"type":"inlineCode","value":"z","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gg7rQyYi8Y"},{"type":"text","value":", then map reflectivity onto a Cartopy projection for\ngeographic context.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"M7sKqZTgv6"}],"key":"k5kCM2towS"}],"identifier":"7891b679-db59-4848-a00c-e6c2f1d96713","html_id":"7891b679-db59-4848-a00c-e6c2f1d96713","key":"bvE865OW0q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dt_ppi = dt_ppi.xradar.georeference()\ndt_ppi = xd.georeference.get_x_y_z_tree(dt_ppi)\nds_ppi = dt_ppi[\"sweep_0\"].to_dataset()\nda_dbz = ds_ppi[\"DBZ\"]","key":"xyCMjVYjap"},{"type":"outputs","id":"VitxsxxHjU_4cbX603GSM","children":[],"key":"Shg24XMvpN"}],"identifier":"dc5b98ad-09b0-4059-aef7-bd7348195146","html_id":"dc5b98ad-09b0-4059-aef7-bd7348195146","key":"gSPyGy33HB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"radar_crs = ccrs.Projection(xd.georeference.get_crs(ds_ppi))\n\nfig = plt.figure(figsize=(10, 10))\nax = fig.add_subplot(111, projection=ccrs.PlateCarree())\nda_dbz.plot(\n    x=\"x\",\n    y=\"y\",\n    transform=radar_crs,\n    cmap=\"ChaseSpectral\",\n    levels=np.arange(-10, 55, 1),\n    cbar_kwargs={\"label\": \"Reflectivity (dBZ)\", \"shrink\": 0.75, \"pad\": 0.075},\n)\nax.coastlines()\nax.gridlines(draw_labels=True)\nax.set_title(f\"S-Pol PPI reflectivity — sweep 0 (elevation {ds_ppi.elevation.values[0]:.2f}°)\")\nplt.show()","key":"TE4WeR7liB"},{"type":"outputs","id":"ijg7otvlphLMqX2Gq-527","children":[],"key":"cbPjXwCByF"}],"identifier":"19ea5d17-0ec9-4bf5-9de5-3d8ff3384fb2","html_id":"19ea5d17-0ec9-4bf5-9de5-3d8ff3384fb2","key":"XglXLu2HhG"},{"type":"block","kind":"notebook-content","children":