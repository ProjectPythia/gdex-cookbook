 (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"j6R59Jo6wk"},{"type":"inlineCode","value":"sweep_0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zzaebhrSWg"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JWLUMFP2Bp"},{"type":"inlineCode","value":"sweep_1","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hn7100H9Zx"},{"type":"text","value":", …) is a node in the tree.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ncd0Gu8Il0"}],"key":"D1A9aoXxOZ"}],"identifier":"796a79df-6f4f-4653-81e8-71a7e55708b5","html_id":"796a79df-6f4f-4653-81e8-71a7e55708b5","key":"ylYIxfRc5q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dt_rhi = xr.open_datatree(rhi_url, engine=\"zarr\", decode_timedelta=False)\ndt_ppi = xr.open_datatree(ppi_url, engine=\"zarr\", decode_timedelta=False)\ndt_rhi","key":"sZrAyAh9fj"},{"type":"outputs","id":"MTvEE4rM0x_n422hif86c","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"error","traceback":"\u001b[31m--------------------------------------------------------...","ename":"ClientPayloadError","evalue":"Response payload is not completed: <ContentLengthError: 400, message='Not enough data to satisfy content length header (received 0 of 6437 bytes).'>","hash":"06e45e9fe652805f27414196fc85305e","path":"/gdex-cookbook/build/06e45e9fe652805f27414196fc85305e.txt"},"key":"gncO1cvy34"}],"key":"R3yGWprpG6"}],"identifier":"c9a620b3-a547-40bf-940b-c9d45e335a39","html_id":"c9a620b3-a547-40bf-940b-c9d45e335a39","key":"LezCtS4eIE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing the RHI (vertical) scan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UpzJAGKlaJ"}],"identifier":"visualizing-the-rhi-vertical-scan","label":"Visualizing the RHI (vertical) scan","html_id":"visualizing-the-rhi-vertical-scan","implicit":true,"key":"EbX2ho2cua"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We extract the first sweep, compute each gate’s altitude from its range and\nelevation angle (accounting for Earth’s curvature), and plot reflectivity as a\nrange–altitude cross-section.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uvL4vdx9fh"}],"key":"mmiDJ518fA"}],"identifier":"52d5b0d8-c713-4f5e-a276-212dc82ff308","html_id":"52d5b0d8-c713-4f5e-a276-212dc82ff308","key":"fUeOCTEZ4n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_rhi = dt_rhi[\"sweep_0\"].to_dataset()\n\n\ndef rhi_altitude(r, elevation_deg):\n    \"\"\"Beam altitude (km) from range (m) and elevation angle (deg), with Earth curvature.\"\"\"\n    r_earth = 6_371_000.0\n    e = np.deg2rad(elevation_deg)\n    return (np.sqrt(r**2 + r_earth**2 + 2 * r * r_earth * np.sin(e)) - r_earth) / 1000.0\n\n\nds_rhi[\"rhi_alt\"] = rhi_altitude(ds_rhi[\"range\"], ds_rhi[\"elevation\"]).compute()\nds_rhi = ds_rhi.set_coords(\"rhi_alt\")\nds_rhi[\"range\"] = ds_rhi[\"range\"] / 1000.0\nds_rhi[\"rhi_alt\"].attrs = {\"long_name\": \"RHI altitude\", \"units\": \"km\"}\nds_rhi[\"range\"].attrs[\"units\"] = \"km\"","key":"q2997NyKzi"},{"type":"outputs","id":"imOxuPsenNvFO3XU8ZUDY","children":[],"key":"tLaXcXvpHz"}],"identifier":"e5821db7-bf9c-47ed-a72d-7a168a8bd98d","html_id":"e5821db7-bf9c-47ed-a72d-7a168a8bd98d","key":"nbh1m98h2K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(16, 4))\nds_rhi[\"DBZ\"].plot.pcolormesh(\n    x=\"range\",\n    y=\"rhi_alt\",\n    cmap=\"ChaseSpectral\",\n    levels=np.arange(-10, 55, 1),\n    ax=ax,\n    cbar_kwargs={\"label\": \"Reflectivity (dBZ)\"},\n)\nax.set_xlabel(\"Range (km)\")\nax.set_ylabel(\"Altitude (km)\")\nax.set_xlim(0, 150)\nax.set_ylim(0, 15)\nax.set_title(\n    f\"S-Pol RHI reflectivity — 2022-05-25 \"\n    f\"(lon {ds_rhi.longitude.values:.2f}, lat {ds_rhi.latitude.values:.2f})\"\n)\nplt.show()","key":"RU3civDtDC"},{"type":"outputs","id":"J9aSSwlE0vWjfgmVqUoyc","children":[],"key":"tlhlh25xlX"}],"identifier":"f4c8965f-e4b9-42b5-9930-f5b631a101ea","html_id":"f4c8965f-e4b9-42b5-9930-f5b631a101ea","key":"dkfT74ZICd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing the PPI (horizontal) scan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RlXOienntq"}],"identifier":"visualizing-the-ppi-horizontal-scan","label":"Visualizing the PPI (horizontal) scan","html_id":"visualizing-the-ppi-horizontal-scan","implicit":true,"key":"D5Dzadnn4C"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For the surveillance scan we use ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uWeShKhfqj"},{"type":"inlineCode","value":"xradar","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"g6i2uivbMm"},{"type":"text","value":" to georeference the polar coordinates into\nCartesian ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UEnoDQef7w"},{"type":"inlineCode","value":"x","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JgHx8NsP3X"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uvbxa4W83e"},{"type":"inlineCode","value":"y","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kr77ACcNyZ"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DFwyzailId"},{"type":"inlineCode","value":"z","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"l2KEdDVcct"},{"type":"text","value":", then map reflectivity onto a Cartopy projection for\ngeographic context.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lPGBqu8eKY"}],"key":"RfFE2CXkqJ"}],"identifier":"7891b679-db59-4848-a00c-e6c2f1d96713","html_id":"7891b679-db59-4848-a00c-e6c2f1d96713","key":"KCuWWHj7Yd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dt_ppi = dt_ppi.xradar.georeference()\ndt_ppi = xd.georeference.get_x_y_z_tree(dt_ppi)\nds_ppi = dt_ppi[\"sweep_0\"].to_dataset()\nda_dbz = ds_ppi[\"DBZ\"]","key":"Xkq0KFe5sk"},{"type":"outputs","id":"Rp5ywCXLjNNcwkuK-ozfR","children":[],"key":"LgGxbPI1jW"}],"identifier":"dc5b98ad-09b0-4059-aef7-bd7348195146","html_id":"dc5b98ad-09b0-4059-aef7-bd7348195146","key":"tbfOTyWrx4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"radar_crs = ccrs.Projection(xd.georeference.get_crs(ds_ppi))\n\nfig = plt.figure(figsize=(10, 10))\nax = fig.add_subplot(111, projection=ccrs.PlateCarree())\nda_dbz.plot(\n    x=\"x\",\n    y=\"y\",\n    transform=radar_crs,\n    cmap=\"ChaseSpectral\",\n    levels=np.arange(-10, 55, 1),\n    cbar_kwargs={\"label\": \"Reflectivity (dBZ)\", \"shrink\": 0.75, \"pad\": 0.075},\n)\nax.coastlines()\nax.gridlines(draw_labels=True)\nax.set_title(f\"S-Pol PPI reflectivity — sweep 0 (elevation {ds_ppi.elevation.values[0]:.2f}°)\")\nplt.show()","key":"z9ELUfCr4m"},{"type":"outputs","id":"TEQpWREPA8AYwkwRfhLdW","children":[],"key":"FTZoa8Xuyc"}],"identifier":"19ea5d17-0ec9-4bf5-9de5-3d8ff3384fb2","html_id":"19ea5d17-0ec9-4bf5-9de5-3d8ff3384fb2","key":"ThiRvdAYQ1"},{"type":"block","kind":"notebook-content","children"