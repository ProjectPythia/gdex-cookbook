ar_kwargs={\"label\": \"Reflectivity (dBZ)\", \"shrink\": 0.75, \"pad\": 0.075},\n)\nax.coastlines()\nax.gridlines(draw_labels=True)\nax.set_title(f\"S-Pol PPI reflectivity — sweep 0 (elevation {ds_ppi.elevation.values[0]:.2f}°)\")\nplt.show()","key":"Naq3eUK1Ug"},{"type":"outputs","id":"NfTkEnYV2K_b1GBAZaHn-","children":[],"key":"gbB8bPZ0dq"}],"key":"L96Mv8pvsi"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bTdkKGHAzF"}],"key":"PdASfcLDCq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fCCS9C4teS"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"HY5ctawsQF"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We opened NCAR S-Pol radar scans from the PRECIP campaign as CfRadial2 Zarr\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"U1Nmfo5gkI"},{"type":"inlineCode","value":"DataTree","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rI739p4RcL"},{"type":"text","value":"s over OSDF, extracted single sweeps, and plotted reflectivity as a\nvertical RHI cross-section and a georeferenced horizontal PPI map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Wz6z88fEUp"}],"key":"sWAdEJ1NV1"},{"type":"heading","depth":3,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"What’s next?","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"yNs0fTzdMf"}],"identifier":"whats-next","label":"What’s next?","html_id":"whats-next","implicit":true,"key":"BGlzAl9Rdu"},{"type