key":"tMNrXLVwRD"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"HadISST is distributed as a single gzip-compressed NetCDF file. We stream it from\nGDEX over the OSDF director, decompress it in memory, and open it with xarray.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xuk73dxdJa"}],"key":"W53JgG8jkb"}],"identifier":"db195bcb-5218-4954-993d-4127f8368463","html_id":"db195bcb-5218-4954-993d-4127f8368463","key":"SC5ssiAqm3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"url = \"https://osdf-director.osg-htc.org/ncar/gdex/d277003/HadISST_sst.nc.gz\"\n\nresponse = requests.get(url)\nresponse.raise_for_status()\nraw = gzip.decompress(response.content)\n\nwith tempfile.NamedTemporaryFile(suffix=\".nc\") as tmp:\n    tmp.write(raw)\n    tmp.flush()\n    ds = xr.open_dataset(tmp.name, engine=\"scipy\", decode_times=False)\n\nds = xr.decode_cf(ds)\nds","key":"yhI741NgNt"},{"type":"outputs","id":"qogf1ruC2bFOUgU7lObuo","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"error","traceback":"\u001b[31m---------------------------------------------------------------------------\u001b[39m\n\u001b[31mHTTPError\u001b[39m                                 Traceback (most recent call last)\n\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[2]\u001b[39m\u001b[32m, line 4\u001b[39m\n\u001b[32m      1\u001b[39m url = \u001b[33m\"https://osdf-director.osg-htc.org/ncar/gdex/d277003/HadISST_sst.nc.gz\"\u001b[39m\n\u001b[32m      2\u001b[39m \n\u001b[32m      3\u001b[39m response = requests.get(url)\n\u001b[32m----> \u001b[39m\u001b[32m4\u001b[39m response.raise_for_status()\n\u001b[32m      5\u001b[39m raw = gzip.decompress(response.content)\n\u001b[32m      6\u001b[39m \n\u001b[32m      7\u001b[39m \u001b[38;5;28;01mwith\u001b[39;00m tempfile.NamedTemporaryFile(suffix=\u001b[33m\".nc\"\