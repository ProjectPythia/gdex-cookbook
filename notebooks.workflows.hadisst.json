":{"line":7,"column":1}},"key":"u2NWPeOXVJ"}],"key":"ryKePfmnpx"}],"key":"IrVk0Avylb"}],"key":"C15nzw55JE"}],"identifier":"87442e43-d771-4c98-91ae-5497bcc3e551","html_id":"87442e43-d771-4c98-91ae-5497bcc3e551","key":"Ri0Bfw6DvB"}],"key":"qtqJcQImmx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CONUS404: Monthly Precipitation over the Contiguous US","url":"/notebooks/workflows/conus404","group":"Model Simulations"},"next":{"title":"S-Pol Radar Reflectivity from the PRECIP Field Campaign","url":"/notebooks/workflows/radar","group":"Observations"}}},"domain":"http://localhost:3000"}