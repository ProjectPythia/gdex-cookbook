"column":1}},"children":[{"type":"text","value":"HadISST flags land and missing values with large negative numbers, and uses\nlongitudes from −180° to 180°. We mask the fill values and convert to a 0–360°\nlongitude convention so the Pacific Niño regions form contiguous boxes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ct9NNuHjiT"}],"key":"Syc3M0gngY"}],"identifier":"91411e6f-7249-4a55-9861-1972907f155d","html_id":"91411e6f-7249-4a55-9861-1972907f155d","key":"BDukmMcqGr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def lon_to_360(da):\n    lon_name = \"lon\" if \"lon\" in da.coords else \"longitude\"\n    lon360 = da[lon_name] % 360\n    return da.assign_coords({lon_name: lon360}).sortby(lon_name)\n\n\nsst = lon_to_360(ds[\"sst\"])\nsst = sst.where(sst > -100)  # mask land and fill values","key":"sqdLaTnPrH"},{"type":"outputs","id":"dV_E7ahjYfaNForzD35qk","children":[],"key":"e3VOMTOi26"}],"identifier":"4331c090-799b-4dd2-b6ee-9efba16d4faa","html_id":"4331c090-799b-4dd2-b6ee-9efba16d4faa","key":"LH2PgyVXwX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Defining the Niño regions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bbWqOmTpu2"}],"identifier":"defining-the-ni-o-regions","label":"Defining the Niño regions","html_id":"defining-the-ni-o-regions","implicit":true,"key":"JuYbKjHhur"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"ENSO is monitored over several boxes spanning the equatorial Pacific. We define the\nstandard four — Niño 1+2, 3, 3.4, and 4 — running from the South American coast\nwestward into the central Pacific.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"G4hgMIBTS0"}],"key":"QaHb1lSyBb"}],"identifier":"38ee865b-af4d-4099-ba10-4c9c46df3a0a","html_id":"38ee865b-af4d-4099-ba10-4c9c46df3a0a","key":"M8d8rTmxsV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def area_mean(da):\n    weights = np.cos(np.deg2rad(da[\"latitude\"]))\n    return da.weighted(weights).mean(dim=(\"latitude\", \"longitude\"), skipna=True)\n\n\nNINO_REGIONS = {\n    \"nino12\": {\"latitude\": (0, -10), \"longitude\": (270, 280)},\n    \"nino3\": {\"latitude\": (5, -5), \"longitude\": (210, 270)},\n    \"nino34\": {\"latitude\": (5, -5), \"longitude\": (190, 240)},\n    \"nino4\": {\"latitude\": (5, -5), \"longitude\": (160, 210)},\n}","key":"pPR7xFGHzO"},{"type":"outputs","id":"nvEBYpXCuWVgJHzLVO0Sr","children":[],"key":"iPyY4S7QNz"}],"identifier":"0f4de2e0-0786-4345-baa8-22c007e06fc1","html_id":"0f4de2e0-0786-4345-baa8-22c007e06fc1","key":"gOeZDzvynd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Computing the Niño indices","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TvhcQUnLsp"}],"identifier":"computing-the-ni-o-indices","label":"Computing the Niño indices","html_id":"computing-the-ni-o-indices","implicit":true,"key":"tkY8oww9JY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For each region we area-average SST, remove the monthly climatology to get\nanomalies, then apply a 3-month running mean — the recipe behind NOAA’s Oceanic\nNiño Index (ONI).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fPeeE6ZWuL"}],"key":"stZmw8SI7p"}],"identifier":"f9fb05c3-d1c9-4a10-bc75-818a04ba91ee","html_id":"f9fb05c3-d1c9-4a10-bc75-818a04ba91ee","key":"bXOaDhS6ro"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def nino_index(sst, box):\n    sub = sst.sel(\n        latitude=slice(*box[\"latitude\"]),\n        longitude=slice(*box[\"longitude\"]),\n    )\n    return area_mean(sub)\n\n\nraw = xr.Dataset({name: nino_index(sst, box) for name, box in NINO_REGIONS.items()})\n\nclim = raw.groupby(\"time.month\").mean(\"time\")\nanom = raw.groupby(\"time.month\") - clim\nindices = anom.rolling(time=3, center=True).mean()","key":"R6c6CFIAxk"},{"type":"outputs","id":"8fEoBQYzmcdif4hyEBq8G","children":[],"key":"K5qVwGL8iR"}],"identifier":"24e257ff-5c00-4f75-9841-baed815058b9","html_id":"24e257ff-5c00-4f75-9841-baed815058b9","key":"LKxgCAjwuJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing ENSO","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kF2eEcljfh"}],"identifier":"visualizing-enso","label":"Visualizing ENSO","html_id":"visualizing-enso","implicit":true,"key":"ALlzB3aVqw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Shading each anomaly red above +0.5 °C and blue below −0.5 °C — the conventional\nEl Niño / La Niña thresholds — turns the series into recognizable ENSO records. The\neastern regions (1+2, 3) swing more than the central-Pacific Niño 4.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jlsOMSkp9i"}],"key":"MVC7MWpBQN"}],"identifier":"43db5fed-6ca6-411f-81d5-7dc058cccc16","html_id":"43db5fed-6ca6-411f-81d5-7dc058cccc16","key":"dd5ARygfBj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = indices[\"time\"].values\n\nfig, axes = plt.subplots(4, 1, figsize=(12, 10), sharex=True)\nfor ax, name in zip(axes, [\"nino12\", \"nino3\", \"nino34\", \"nino4\"]):\n    y = indices[name].values\n    ax.plot(t, y, color=\"black\", lw=0.7)\n    ax.fill_between(t, 0.5, y, where=(y >= 0.5), color=\"tab:red\", alpha=0.6, interpolate=True)\n    ax.fill_between(t, -0.5, y, where=(y <= -0.5), color=\"tab:blue\", alpha=0.6, interpolate=True)\n    ax.axhline(0.5, color=\"grey\", lw=0.5, ls=\"--\")\n    ax.axhline(-0.5, color=\"grey\", lw=0.5, ls=\"--\")\n    ax.set_ylabel(f\"{name}\\n(°C)\")\n\naxes[-1].set_xlabel(\"Year\")\nfig.suptitle(\"Niño SST anomaly indices from HadISST (3-month running mean)\")\nplt.tight_layout()\nplt.show()","key":"O9Ncp5VKQH"},{"type":"outputs","id":"jybNFFxy4m__lpe_cn9o8","children":[],"key":"NuWi6TMhkF"}],"identifier":"f30b288e-ee7f-4fe9-8457-0c115c2dd26a","html_id":"f30b288e-ee7f-4fe9-8457-0c115c2dd26a","key":"ME0g552ijY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Spatial patterns of El Niño and La Niña","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MoIyGEGYnu"}],"identifier":"spatial-patterns-of-el-ni-o-and-la-ni-a","label":"Spatial patterns of El Niño and La Niña","html_id":"spatial-patterns-of-el-ni-o-and-la-ni-a","implicit":true,"key":"Is55RVAg8R"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"The indices collapse the Pacific into a single number, but the events have a\ndistinctive spatial signature. Computing the full SST anomaly field and mapping a\nstrong El Niño against a strong La Niña shows the warm and cold “tongues” that\nstretch along the equator.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZvEcLXUwh5"}],"key":"ghoUdimcDR"}],"identifier":"4e4e8199-6c39-494a-9c40-7b2e3e0b4b88","html_id":"4e4e8199-6c39-494a-9c40-7b2e3e0b4b88","key":"cPQc5XqsIm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sst_clim = sst.groupby(\"time.month\").mean(\"time\")\nsst_anom = sst.groupby(\"time.month\") - sst_clim\n\nevents = {\n    \"El Niño\": indices[\"nino34\"].idxmax(\"time\"),\n    \"La Niña\": indices[\"nino34\"].idxmin(\"time\"),\n}\n\nproj = ccrs.PlateCarree(central_longitude=180)\nfig, axes = plt.subplots(1, 2, figsize=(14, 4), subplot_kw={\"projection\": proj})\n\nfor ax, (kind, date) in zip(axes, events.items()):\n    field = sst_anom.sel(time=date)\n    p = field.plot(\n        ax=ax,\n        transform=ccrs.PlateCarree(),\n        x=\"longitude\",\n        y=\"latitude\",\n        cmap=\"RdBu_r\",\n        vmin=-3,\n        vmax=3,\n        add_colorbar=False,\n    )\n    ax.coastlines(color=\"black\", linewidth=0.6)\n    ax.set_extent([120, 290, -30, 30], crs=ccrs.PlateCarree())\n    ax.set_title(f\"{kind} — {np.datetime_as_string(date.values, unit='M')}\")\n\nfig.colorbar(p, ax=axes, orientation=\"horizontal\", shrink=0.5, pad=0.08, label=\"SST anomaly (°C)\")\nplt.show()","key":"iHkfYKhEEJ"},{"type":"outputs","id":"on7I9kYpYse1XsYIhm2dF","children":[],"key":"GnwLmWzsku"}],"identifier":"daeddddf-141e-4127-aa4e-9edd65227844","html_id":"daeddddf-141e-4127-aa4e-9edd65227844","key":"YzGh3vZKR0"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xqttMJ96E4"}],"identifier":"170382e6-4ae0-4af1-9c6e-444821f453a7","html_id":"170382e6-4ae0-4af1-9c6e-444821f453a7","key":"s9JGUcl8pe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L1shJm80J4"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"fuDd12KP35"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"We streamed HadISST sea surface temperature from GDEX over OSDF, masked land, and\ncomputed the four standard Niño SST anomaly indices with a 3-month running mean.\nMapping the SST anomaly for a strong El Niño against a strong La Niña revealed the\nequatorial warm and cold tongues behind the indices.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OfQSWj19H0"}],"key":"hqdWYztPTl"},{"type":"heading","depth":3,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"What’s next?","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"jofcjNmI6P"}],"identifier":"whats-next","label":"What’s next?","html_id":"whats-next","implicit":true,"key":"JbH669bfmz"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Continue to the ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"xvKNNK20vI"},{"type":"link","url":"/notebooks/workflows/radar","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Radar Data Workflow","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"bCY5awzSGT"}],"urlSource":"radar.ipynb","dataUrl":"/notebooks.workflows.radar.json","internal":true,"protocol":"file","key":"Uc5dBf2Elz"},{"type":"text","value":", which works with another\nGDEX observational dataset.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"ItULRAGeuT"}],"key":"bOhS8Ov7s9"}],"identifier":"064d5081-2ef2-42c1-a115-d2016f418bb5","html_id":"064d5081-2ef2-42c1-a115-d2016f418bb5","key":"D2PaVilvOg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Resources and references","position":{"