}],"key":"eI55Rq3TTD"}],"key":"SwCnGMM3zN"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CONUS404: Monthly Precipitation over the Contiguous US","url":"/notebooks/workflows/conus404","group":"Model Simulations"},"next":{"title":"S-Pol Radar Reflectivity from the PRECIP Field Campaign","url":"/notebooks/workflows/radar","group":"Observations"}}},"domain":"http://localhost:3000"}