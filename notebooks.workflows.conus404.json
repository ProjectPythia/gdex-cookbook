art":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"reREoopMyi"}],"key":"T6nBW1DuvT"},{"type":"text","value":" CONUS404 variables (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iDU8X3Isxk"},{"type":"inlineCode","value":"wrf2d","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JKMylCFvtW"},{"type":"text","value":") —\nprecipitation, 2-m temperature, surface fluxes, and more. We open it over HTTPS and\npull out hourly accumulated precipitation, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CGlY5686zY"},{"type":"inlineCode","value":"PREC_ACC_NC","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"N6xj5GM1rp"},{"type":"text","value":" (mm), along with the static\n2D lat/lon needed for mapping.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jaLR3mKuSQ"}],"key":"uSucuWnCJp"}],"key":"CO9BFwvNLV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nkerchunk_url = \"https://data.gdex.ucar.edu/d559000/kerchunk/wrf2d-remote-https.parq\"\n\nds = xr.open_dataset(kerchunk_url, engine=\"kerchunk\", \\\n                     storage_options={\"remote_protocol\": \"https\"})\npr = ds[\"PREC_ACC_NC\"]\nlat2d = ds[\"XLAT\"].isel(Time=0)\nlon2d = ds[\"XLONG\"].isel(Time=0)\npr","key":"bSyu0tIw5m"},{"type":"outputs","id":"SGC49jaian8DMEotHTFNw","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"CPU times: user 1.01 s, sys: 203 ms, total: 1.21 s\nWall time: 2.96 s\n"},"key":"YNmxVvMRft"},{"type":"output","children":[],"jupyter_data":{"output_type":"error","traceback":"\u001b[31m--------------------------------------------------------...","ename":"ClientConnectorCertificateError","evalue":"Cannot connect to host data.gdex.ucar.edu:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: self-signed certificate in certificate chain (_ssl.c:1010)')]","hash":"3f3ab55e185138cc7ecf25278250d600","path":"/gdex-cookbook/build/3f3ab55e185138cc7ecf25278250d600.txt"},"key":"qWQdREPqrA"}],"key":"PRPUzfccfH"}],"key":"dZFqOgHdRK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nmonth = \"2017-02\"\npr_month = pr.sel(Time=month).sum(\"Time\").compute()","key":"Od2WlANXKq"},{"type":"outputs","id":"ofMOTydUW6B08bEw2xx2F","children":[],"key":"piioWWi4u3"}],"key":"tmExAVzB25"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Mapping the monthly total","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rNclifeuOP"}],"identifier":"mapping-the-monthly-total","label":"Mapping the monthly total","html_id":"mapping-the-monthly-total","implicit":true,"key":"fVjsTEMxfs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"CONUS404 sits on a Lambert Conformal grid. We coarsen 4× for plotting (to spare\nCartopy memory) and use the NCL ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"McVndEQVkV"},{"type":"inlineCode","value":"precip3_16lev","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IikVHSskEE"},{"type":"text","value":" palette.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EnsR8Jw01u"}],"key":"uuAKb1Z69Y"}],"key":"vGM0AFwMHD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj = ccrs.LambertConformal(central_longitude=-97.5, central_latitude=38.5)\ntrans = ccrs.PlateCarree()\n\n_rgb255 = [\n    (255, 255, 255), (214, 226, 255), (181, 201, 255), (142, 178, 255),\n    (127, 150, 255), (114, 133, 248), (99, 112, 248), (0, 158, 30),\n    (60, 188, 61), (179, 209, 110), (185, 249, 110), (255, 249, 19),\n    (255, 163, 9), (229, 0, 0), (189, 0, 31), (165, 0, 33),\n]\ncmap_pr = ListedColormap(np.array(_rgb255) / 255, name=\"precip3_16lev\")\nlevels = np.arange(0, 301, 20)\nnorm = BoundaryNorm(levels, ncolors=cmap_pr.N, extend=\"max\")\n\nkw = dict(south_north=4, west_east=4, boundary=\"trim\")\npr_plot = pr_month.coarsen(**kw).mean()\nlat_plot = lat2d.coarsen(**kw).mean()\nlon_plot = lon2d.coarsen(**kw).mean()\n\nfig, ax = plt.subplots(figsize=(11, 7), subplot_kw={\"projection\": proj})\nim = ax.pcolormesh(\n    lon_plot.values, lat_plot.values, pr_plot.values,\n    transform=trans, cmap=cmap_pr, norm=norm, shading=\"auto\",\n)\nax.add_feature(cfeature.COASTLINE, lw=0.4)\nax.add_feature(cfeature.BORDERS, lw=0.4)\nax.add_feature(cfeature.STATES, lw=0.2)\nax.set_extent([-125, -66, 24, 50], crs=trans)\n\nfig.colorbar(im, ax=ax, shrink=0.7, ticks=levels, extend=\"max\",\n             label=\"Monthly precipitation (mm)\")\nax.set_title(\"CONUS404 total precipitation — February 2017\")\nplt.show()","key":"rkHTlcKxRO"},{"type":"outputs","id":"03An-kxqZePG_3PrkETyd","children":[],"key":"upDRrthVDq"}],"key":"t5nXwrKHYg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"client.close()\ncluster.close()","key":"qEoXK7RLV4"},{"type":"outputs","id":"EamHRfxN4aRkZsh8OJpD9","children":[],"key":"VNjLtIO1jh"}],"key":"sbOtJ7cRqK"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HskxRzmUbJ"}],"key":"KMVfzFPtHm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JatZfUWcOf"}],"identifier":"