tps://data.gdex.ucar.edu/d559000/kerchunk/wrf2d-remote-https.parq\"\n\nds = xr.open_dataset(kerchunk_url, engine=\"kerchunk\", \\\n                     storage_options={\"remote_protocol\": \"https\"})\npr = ds[\"PREC_ACC_NC\"]\nlat2d = ds[\"XLAT\"].isel(Time=0)\nlon2d = ds[\"XLONG\"].isel(Time=0)\npr","key":"N1YxIPC3mc"},{"type":"outputs","id":"e18jil1ey5OiSZyZ4jAgI","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"CPU times: user 8.06 s, sys: 1.94 s, total: 10 s\nWall time: 5min 1s\n"},"key":"wFlHJFhDDJ"},{"type":"output","children":[],"jupyter_data":{"output_type":"error","traceback":"\u001b[31m--------------------------------------------------------...","ename":"FSTimeoutError","evalue":"","hash":"79767595a319ed4ad7e1ac479e03b40b","path":"/gdex-cookbook/build/79767595a319ed4ad7e1ac479e03b40b.txt"},"key":"YzkpPZMtdK"}],"key":"kYfJF8aReu"}],"identifier":"c6d2d760-193f-423f-ae62-fd3510b4c9ef","html_id":"c6d2d760-193f-423f-ae62-fd3510b4c9ef","key":"W0NVKHM3nZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nmonth = \"2017-02\"\npr_month = pr.sel(Time=month).sum(\"Time\").compute()","key":"VPymzcIY4H"},{"type":"outputs","id":"Wu5J8cKb089YP0-j6UmjY","children":[],"key":"lN8dkVnMfz"}],"identifier":"ce0ec722-ef3e-4617-853b-2720f84629da","html_id":"ce0ec722-ef3e-4617-853b-2720f84629da","key":"N5XjQ0tZlo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Mapping the monthly total","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QnVIOwgCeZ"}],"identifier":"mapping-the-monthly-total","label":"Mapping the monthly total","html_id":"mapping-the-monthly-total","implicit":true,"key":"u9eCoHRQUo"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"CONUS404 sits on a Lambert Conformal grid. We coarsen 4× for plotting (to spare\nCartopy memory) and use the NCL ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZX0AgBH2UP"},{"type":"inlineCode","value":"precip3_16lev","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wToN44jpe8"},{"type":"text","value":" palette.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rqpZ9u3lL5"}],"key":"RovxRnyxIE"}],"identifier":"ded2fb6c-84cc-40bb-b941-8b140e2f06b3","html_id":"ded2fb6c-84cc-40bb-b941-8b140e2f06b3","key":"eeHy60dPPh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj = ccrs.LambertConformal(central_longitude=-97.5, central_latitude=38.5)\ntrans = ccrs.PlateCarree()\n\n_rgb255 = [\n    (255, 255, 255), (214, 226, 255), (181, 201, 255), (142, 178, 255),\n    (127, 150, 255), (114, 133, 248), (99, 112, 248), (0, 158, 30),\n    (60, 188, 61), (179, 209, 110), (185, 249, 110), (255, 249, 19),\n    (255, 163, 9), (229, 0, 0), (189, 0, 31), (165, 0, 33),\n]\ncmap_pr = ListedColormap(np.array(_rgb255) / 255, name=\"precip3_16lev\")\nlevels = np.arange(0, 301, 20)\nnorm = BoundaryNorm(levels, ncolors=cmap_pr.N, extend=\"max\")\n\nkw = dict(south_north=4, west_east=4, boundary=\"trim\")\npr_plot = pr_month.coarsen(**kw).mean()\nlat_plot = lat2d.coarsen(**kw).mean()\nlon_plot = lon2d.coarsen(**kw).mean()\n\nfig, ax = plt.subplots(figsize=(11, 7), subplot_kw={\"projection\": proj})\nim = ax.pcolormesh(\n    lon_plot.values, lat_plot.values, pr_plot.values,\n    transform=trans, cmap=cmap_pr, norm=norm, shading=\"auto\",\n)\nax.add_feature(cfeature.COASTLINE, lw=0.4)\nax.add_feature(cfeature.BORDERS, lw=0.4)\nax.add_feature(cfeature.STATES, lw=0.2)\nax.set_extent([-125, -66, 24, 50], crs=trans)\n\nfig.colorbar(im, ax=ax, shrink=0.7, ticks=levels, extend=\"max\",\n             label=\"Monthly precipitation (mm)\")\nax.set_title(\"CONUS404 total precipitation — February 2017\")\nplt.show()","key":"yvBtzFXfOg"},{"type":"outputs","id":"ZusrnpOSmDLoRE3FBNIjI","children":[],"key":"VbjBPY7hkk"}],"identifier":"2b551ded-df88-48a2-b8ee-d077ea704fc5","html_id":"2b551ded-df88-48a2-b8ee-d077ea704fc5","key":"yEIqgF9zuZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"client.close()\ncluster.close()","key":"wOLvS61MH9"},{"type":"outputs","id":"6i2ZNq4LVY5eUVQMuyeBR","children":[],"key":"IbPPGTwJUE"}],"identifier":"a6882875-3d55-4bdb-a354-8010062b94ba","html_id":"a6882875-3d55-4bdb-a354-8010062b94ba","key":"hF1PfBnAVg"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qa5pagj0Iy"}],"identifier":"0f62e2ea-f6ff-4032-a3e1-4a6352ccfd4f","html_id":"0f62e2ea-f6ff-4032-a3e1-4a6352ccfd4f","key":"Uej6PGX3QD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lZrhRKYtQR"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"mlgv7LiRSw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"We opened CONUS404’s 2D output from a single kerchunk reference over OSDF, summed\none month of hourly precipitation, and mapped the total across CONUS on the model’s\nnative Lambert Conformal grid. Scoping to one month keeps the stream small — loop\nthe reduction over months or water years to rebuild the published multi-year\nclimatology.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kPtsIn5nLz"}],"key":"l9s0Hhgh7n"}],"identifier":"d60440bd-c5b9-45a2-b284-a94ff22182a4","htm